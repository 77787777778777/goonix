;;; goonix: interoperable age-encryption.org/v1 primitives.
(define-module (guix secrets age)
  #:use-module (guix secrets gcrypt)
  #:use-module (gcrypt base64)
  #:use-module (gcrypt base16)
  #:use-module (gcrypt hash)
  #:use-module (gcrypt mac)
  #:use-module (gcrypt random)
  #:use-module (rnrs bytevectors)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-11)
  #:use-module (ice-9 match)
  #:use-module (ice-9 textual-ports)
  #:use-module (ice-9 binary-ports)
  #:use-module (ice-9 iconv)
  #:use-module (ice-9 regex)
  #:export (generate-x25519-identity
            x25519-identity-public
            parse-x25519-identity
            parse-age-recipient
            encrypt-x25519
            decrypt-x25519
            decrypt-scrypt
            decrypt-age-file
            age-header-stanzas
            read-age-file))

(define (bv-append . bvs)
  (let ((out (make-bytevector (apply + (map bytevector-length bvs)))))
    (fold (lambda (bv offset)
            (bytevector-copy! bv 0 out offset (bytevector-length bv))
            (+ offset (bytevector-length bv))) 0 bvs)
    out))
(define (zero n) (make-bytevector n 0))
(define (string->latin1 s) (string->bytevector s "ISO-8859-1"))
(define (bytevector-slice bv start end)
  (let ((out (make-bytevector (- end start))))
    (let loop ((i start))
      (when (< i end)
        (bytevector-u8-set! out (- i start) (bytevector-u8-ref bv i))
        (loop (+ i 1)))) out))
(define (utf8 s) (string->utf8 s))
(define (raw64 bv) (base64-encode bv 0 (bytevector-length bv) #f #t
                                  base64-alphabet #f))
(define (armor64 bv) (base64-encode bv 0 (bytevector-length bv) #f #f
                                    base64-alphabet #f))
(define (pad64 s)
  (unless (and (string? s)
               (not (= 1 (modulo (string-length s) 4)))
               (not (string-contains s "=")))
    (error "invalid unpadded base64"))
  (let* ((padded (string-append s (make-string (modulo (- (string-length s)) 4) #\=)))
         (decoded (base64-decode padded base64-alphabet)))
    (unless (string=? (raw64 decoded) s)
      (error "non-canonical base64"))
    decoded))
(define (decode-armor64 s)
  (unless (and (zero? (modulo (string-length s) 4))
               (not (string-contains s "\n")))
    (error "invalid padded armor base64"))
  (let ((decoded (base64-decode s base64-alphabet)))
    (unless (string=? (armor64 decoded) s)
      (error "non-canonical armor base64"))
    decoded))
(define (hmac key data) (sign-data key data #:algorithm (mac-algorithm hmac-sha256)))
(define (constant= a b)
  (and (= (bytevector-length a) (bytevector-length b))
       (zero? (fold (lambda (x y acc) (logior acc (logxor x y))) 0
                    (bytevector->u8-list a) (bytevector->u8-list b)))))
(define (hkdf salt secret info)
  (let* ((salt (if (= (bytevector-length salt) 0) (zero 32) salt))
         (prk (hmac salt secret)))
    (bytevector-slice (hmac prk (bv-append info (make-bytevector 1 1))) 0 32)))

;; age keys use the original Bech32 checksum, not Bech32m.
(define bech32-alphabet "qpzry9x8gf2tvdw0s3jn54khce6mua7l")
(define (polymod values)
  (let loop ((chk 1) (values values))
    (if (null? values) chk
        (let* ((top (ash chk -25))
               (chk (logxor (ash (logand chk #x1ffffff) 5) (car values)))
               (chk (if (zero? (logand top 1)) chk (logxor chk #x3b6a57b2)))
               (chk (if (zero? (logand top 2)) chk (logxor chk #x26508e6d)))
               (chk (if (zero? (logand top 4)) chk (logxor chk #x1ea119fa)))
               (chk (if (zero? (logand top 8)) chk (logxor chk #x3d4233dd)))
               (chk (if (zero? (logand top 16)) chk (logxor chk #x2a1462b3))))
          (loop chk (cdr values))))))
(define (hrp-expand hrp)
  (append (map (lambda (c) (ash (char->integer c) -5)) (string->list hrp))
          '(0) (map (lambda (c) (logand (char->integer c) 31)) (string->list hrp))))
(define (convert-bits bytes from to padded?)
  "Convert BYTES to a list of TO-bit integers, most significant bit first."
  (let ((mask (- (ash 1 to) 1)))
    (let loop ((input bytes) (acc 0) (bits 0) (result '()))
      (if (null? input)
          (reverse (if (and padded? (positive? bits))
                       (cons (logand (ash acc (- to bits)) mask) result)
                       result))
          (let ((acc (logior (ash acc from) (car input)))
                (bits (+ bits from)))
            (let emit ((acc acc) (bits bits) (result result))
              (if (< bits to)
                  (loop (cdr input) acc bits result)
                  (let ((shift (- bits to)))
                    (emit acc shift
                          (cons (logand (ash acc (- shift)) mask) result))))))))))
(define (base32 bytes) (convert-bits (bytevector->u8-list bytes) 8 5 #t))
(define (from-base32 values) (list->u8vector (convert-bits values 5 8 #f)))
(define (bech32 hrp bytes)
  (let* ((values (base32 bytes))
         (p (logxor (polymod (append (hrp-expand (string-downcase hrp)) values '(0 0 0 0 0 0))) 1))
         (encoded
          (string-append
           hrp "1"
           (list->string
            (map (lambda (x) (string-ref bech32-alphabet x))
                 (append values
                         (map (lambda (i)
                                (logand (ash p (- (* 5 (- 5 i)))) 31))
                              '(0 1 2 3 4 5))))))))
    (if (string=? hrp (string-upcase hrp)) (string-upcase encoded) encoded)))
(define (unbech32 expected text)
  (let ((pos (string-rindex text #\1)))
    (unless pos (error "invalid Bech32 key"))
    (let ((hrp (substring text 0 pos))
          (chars (string->list (substring text (+ pos 1)))))
      (unless (string=? hrp expected) (error "wrong age key type"))
      (let ((values (map (lambda (c)
                           (or (string-index bech32-alphabet (char-downcase c))
                               (error "invalid Bech32 character"))) chars)))
        (unless (= (polymod (append (hrp-expand (string-downcase hrp)) values)) 1)
          (error "invalid Bech32 checksum"))
        (from-base32 (list-head values (- (length values) 6)))))))

(define (generate-x25519-identity)
  (bech32 "AGE-SECRET-KEY-" (gen-random-bv 32)))
(define (x25519-identity-public identity)
  (bech32 "age" (x25519-public-key (unbech32 "AGE-SECRET-KEY-" identity))))
(define (parse-x25519-identity text)
  (find (lambda (line) (string-prefix? "AGE-SECRET-KEY-" line))
        (string-split text #\newline)))
(define (parse-age-recipient text) (unbech32 "age" text))

(define (stanza type args body) (list type args body))
(define (wrap-x25519 file-key recipient)
  (let* ((secret (gen-random-bv 32))
         (ephemeral (x25519-public-key secret))
         (shared (x25519 secret recipient))
         (key (hkdf (bv-append ephemeral recipient) shared
                    (utf8 "age-encryption.org/v1/X25519"))))
    (stanza "X25519" (list (raw64 ephemeral))
            (chacha20-poly1305-seal key (zero 12) file-key))))
(define (wrap-lines body)
  (let ((s (armor64 body)))
    (let loop ((s s))
      (if (> (string-length s) 64)
          (string-append (substring s 0 64) "\n" (loop (substring s 64)))
          (string-append s "\n")))))
(define (wrap-stanza-lines body)
  (let ((s (raw64 body)))
    (let loop ((s s))
      (if (> (string-length s) 64)
          (string-append (substring s 0 64) "\n" (loop (substring s 64)))
          (string-append s "\n")))))
(define (header-prefix stanzas)
  (string-append "age-encryption.org/v1\n"
                 (apply string-append
                        (map (match-lambda ((type args body)
                                            (string-append "-> " type
                                                           (apply string-append (map (lambda (x) (string-append " " x)) args))
                                                           "\n" (wrap-stanza-lines body)))) stanzas))
                 "---"))
(define (header-mac file-key prefix)
  (raw64 (hmac (hkdf (zero 0) file-key (utf8 "header")) (utf8 prefix))))
(define (nonce counter last?)
  (let ((bv (zero 12)))
    (bytevector-u64-set! bv 3 counter (endianness big))
    (bytevector-u8-set! bv 11 (if last? 1 0)) bv))
(define (encrypt-stream key plaintext)
  (let ((length (bytevector-length plaintext)))
    (let loop ((offset 0) (counter 0))
      (if (and (< offset length) (<= (- length offset) (* 64 1024)))
          (chacha20-poly1305-seal key (nonce counter #t)
                                  (bytevector-slice plaintext offset length))
          (if (zero? length)
              (chacha20-poly1305-seal key (nonce 0 #t) (zero 0))
              (bv-append (chacha20-poly1305-seal key (nonce counter #f)
                                                (bytevector-slice plaintext offset (+ offset (* 64 1024))))
                         (loop (+ offset (* 64 1024)) (+ counter 1))))))))

(define* (encrypt-x25519 plaintext recipients #:key (armor? #t))
  "Return an age v1 ciphertext for a list of native age public key strings."
  (let* ((file-key (gen-random-bv 16))
         (stanzas (map (lambda (r) (wrap-x25519 file-key (parse-age-recipient r))) recipients))
         (prefix (header-prefix stanzas))
         (header (string-append prefix " " (header-mac file-key prefix) "\n"))
         (nonce (gen-random-bv 16))
         (key (hkdf nonce file-key (utf8 "payload")))
         (payload (bv-append nonce (encrypt-stream key plaintext))))
    (if armor?
        (string-append "-----BEGIN AGE ENCRYPTED FILE-----\n"
                       (wrap-lines (bv-append (utf8 header) payload))
                       "-----END AGE ENCRYPTED FILE-----\n")
        (bv-append (utf8 header) payload))))

(define (strip-armor-cr line)
  (let ((n (string-length line)))
    (if (and (positive? n) (char=? #\return (string-ref line (- n 1))))
        (substring line 0 (- n 1)) line)))
(define (armor-bytes input)
  (let* ((text (if (bytevector? input) (bytevector->string input "ISO-8859-1") input))
         (lines (string-split text #\newline))
         (lines (if (and (pair? lines) (string-null? (car (last-pair lines))))
                    (drop-right lines 1) lines))
         (lines (map strip-armor-cr lines))
         (start (list-index (lambda (l) (string=? l "-----BEGIN AGE ENCRYPTED FILE-----")) lines)))
    (unless start (error "missing age armor header"))
    (for-each (lambda (l)
                (unless (every (lambda (c) (memv c '(#\space #\tab #\return))) (string->list l))
                  (error "invalid text before age armor")))
              (take lines start))
    (let* ((lines (drop lines start))
           (header (car lines))
           (end (list-index (lambda (l) (string=? l "-----END AGE ENCRYPTED FILE-----")) (cdr lines))))
      (unless end (error "missing age armor footer"))
      (for-each (lambda (l)
                  (unless (every (lambda (c) (memv c '(#\space #\tab #\return))) (string->list l))
                    (error "invalid text after age armor")))
                (drop lines (+ end 2)))
      (let ((body (take (cdr lines) end)))
        (unless (pair? body) (error "empty age armor"))
        (for-each (lambda (l)
                    (let ((l l))
                      (unless (and (<= 1 (string-length l) 64)
                                   (every (lambda (c) (or (char-alphabetic? c) (char-numeric? c) (memv c '(#\+ #\/ #\=)))) (string->list l)))
                        (error "invalid age armor line")))) body)
        (for-each (lambda (l)
                    (let ((l l))
                      (unless (and (= 64 (string-length l))
                                   (every (lambda (c) (or (char-alphabetic? c) (char-numeric? c) (memv c '(#\+ #\/)))) (string->list l)))
                        (error "invalid age armor line")))) (drop-right body 1))
        (let* ((last (car (last-pair body))))
          (unless (or (= 64 (string-length last))
                      (and (< (string-length last) 64)
                           (not (string-null? last))))
            (error "invalid final age armor line"))
          (decode-armor64 (string-concatenate body)))))))
(define (header-length bytes)
  "Return the byte offset after an age header's MAC newline."
  (let loop ((offset 0))
    (let ((end (let find ((i offset))
                 (when (>= i (bytevector-length bytes)) (error "truncated age header"))
                 (if (= 10 (bytevector-u8-ref bytes i)) i (find (+ i 1))))))
      (if (and (>= end (+ offset 4))
               (= 45 (bytevector-u8-ref bytes offset))
               (= 45 (bytevector-u8-ref bytes (+ offset 1)))
               (= 45 (bytevector-u8-ref bytes (+ offset 2)))
               (= 32 (bytevector-u8-ref bytes (+ offset 3))))
          (+ end 1)
          (loop (+ end 1))))))
(define (valid-token? s)
  (and (string? s) (positive? (string-length s))
       (every (lambda (c) (<= 33 (char->integer c) 126)) (string->list s))))
(define (valid-stanza-line? line)
  (let ((parts (string-split line #\space)))
    (and (>= (length parts) 2)
         (string=? (car parts) "->")
         (every valid-token? (cdr parts))
         (<= (length (cdr parts)) 129))))
(define (header-boundary input)
  (let* ((text (if (bytevector? input) (bytevector->string input "ISO-8859-1") input))
         (armored? (and (string? text)
                        (any (lambda (l) (string=? (string-trim-right l #\return) "-----BEGIN AGE ENCRYPTED FILE-----"))
                             (string-split text #\newline))))
         (decoded (cond (armored? (armor-bytes text))
                        ((bytevector? input) input)
                        (else (string->latin1 text))))
         (header (utf8->string (bytevector-slice decoded 0 (header-length decoded)))))
  (let ((lines (string-split header #\newline)))
    (unless (and (pair? lines) (string=? (car lines) "age-encryption.org/v1"))
      (error "not an age v1 file"))
    (let loop ((lines (cdr lines)) (stanzas '()) (prefix "age-encryption.org/v1\n"))
      (let ((line (car lines)))
        (cond
         ((string-prefix? "--- " line)
          (let* ((prefix (string-append prefix "---"))
                 (mac (substring line 4))
                 (payload (bytevector-slice decoded (header-length decoded)
                                            (bytevector-length decoded))))
            (unless (and (= 2 (length (string-split line #\space)))
                         (= 43 (string-length mac)))
              (error "invalid age header MAC"))
            (pad64 mac)
            (values (reverse stanzas) mac prefix payload)))
         ((not (valid-stanza-line? line)) (error "invalid age stanza"))
         (else
          (let* ((words (string-split line #\space))
                 (type (cadr words)) (args (cddr words)))
            (let body ((ls (cdr lines)) (encoded "") (prefix (string-append prefix line "\n")))
              (when (null? ls) (error "truncated age stanza"))
              (let ((l (car ls)))
                (unless (or (string-null? l)
                            (and (<= 1 (string-length l) 64)
                                 (every (lambda (c) (or (char-alphabetic? c) (char-numeric? c) (memv c '(#\+ #\/)))) (string->list l))))
                  (error "invalid stanza body"))
                (let ((body-part (pad64 l)))
                  (when (> (bytevector-length body-part) 48)
                    (error "age stanza body line is too long"))
                  (if (< (bytevector-length body-part) 48)
                      (loop (cdr ls) (cons (stanza type args (pad64 (string-append encoded l))) stanzas)
                            (string-append prefix l "\n"))
                      (body (cdr ls) (string-append encoded l)
                            (string-append prefix l "\n"))))))))))))))
(define (unwrap-stanza identity stanza)
  (match stanza
    (("X25519" (ephemeral-text) body)
     (let* ((secret (unbech32 "AGE-SECRET-KEY-" identity))
            (ephemeral (pad64 ephemeral-text))
            (public (x25519-public-key secret))
            (shared (x25519 secret ephemeral))
            (key (hkdf (bv-append ephemeral public) shared
                       (utf8 "age-encryption.org/v1/X25519"))))
       (and (= (bytevector-length body) 32)
            (false-if-exception (chacha20-poly1305-open key (zero 12) body)))))
    (_ #f)))
(define (decrypt-stream key data offset)
  (let ((length (- (bytevector-length data) offset)))
    (when (< length 16) (error "truncated age payload"))
    (let loop ((offset offset) (counter 0) (pieces '()))
      (let* ((remaining (- (bytevector-length data) offset))
             (last? (<= remaining (+ (* 64 1024) 16)))
             (n (if last? remaining (+ (* 64 1024) 16))))
        (when (or (< n 16)
                  (and (positive? counter) (= n 16)))
          (error "invalid empty final age payload chunk"))
        (let ((plain (chacha20-poly1305-open key (nonce counter last?)
                                             (bytevector-slice data offset (+ offset n)))))
          (if last?
              (apply bv-append (reverse (cons plain pieces)))
              (loop (+ offset n) (+ counter 1) (cons plain pieces))))))))
(define (decrypt-x25519 text identities)
  "Decrypt TEXT with age identity strings. Never return unauthenticated data."
  (let-values (((stanzas mac prefix payload) (header-boundary text)))
    (let* ((file-key (any (lambda (identity) (any (lambda (s) (unwrap-stanza identity s)) stanzas)) identities)))
      (unless file-key (error "no age identity matches the recipient stanzas"))
      (unless (constant= (pad64 mac) (pad64 (header-mac file-key prefix)))
        (error "age header authentication failed"))
      (let ((nonce (bytevector-slice payload 0 16)))
        (decrypt-stream (hkdf nonce file-key (utf8 "payload")) payload 16)))))

(define (unwrap-scrypt stanza passphrase)
  (match stanza
    (("scrypt" (salt-text work-factor) body)
     (unless (and (= (bytevector-length body) 32)
                  (string-match "^[1-9][0-9]*$" work-factor))
       (error "invalid scrypt recipient stanza"))
     (let* ((salt (pad64 salt-text))
            (n (string->number work-factor)))
       (unless (= 16 (bytevector-length salt))
         (error "invalid scrypt salt"))
       (unless (<= 1 n 22) (error "scrypt work factor is too large"))
       (let ((key (scrypt-key (utf8 passphrase)
                              (bv-append (utf8 "age-encryption.org/v1/scrypt") salt) n)))
         (false-if-exception (chacha20-poly1305-open key (zero 12) body)))))
    (_ #f)))

(define* (decrypt-scrypt text passphrase)
  (let-values (((stanzas mac prefix payload) (header-boundary text)))
    (unless (= 1 (length stanzas)) (error "scrypt must be the only recipient"))
    (let ((file-key (unwrap-scrypt (car stanzas) passphrase)))
      (unless file-key (error "incorrect age passphrase"))
      (unless (constant= (pad64 mac) (pad64 (header-mac file-key prefix)))
        (error "age header authentication failed"))
      (let ((nonce (bytevector-slice payload 0 16)))
        (decrypt-stream (hkdf nonce file-key (utf8 "payload")) payload 16)))))

(define (decrypt-age-file bytes identities)
  "Decrypt binary or ASCII-armored BYTES. Identities may contain strings or
(scrypt . passphrase) pairs; passphrase stanzas are read only."
  (let ((text (if (string? bytes) bytes (bytevector->string bytes "ISO-8859-1"))))
    (if (member "scrypt" (map car (age-header-stanzas (if (bytevector? bytes) bytes text))))
        (decrypt-scrypt (if (bytevector? bytes) bytes text) (or (assoc-ref identities 'scrypt)
                                 (error "no passphrase for age scrypt stanza")))
        (decrypt-x25519 (if (bytevector? bytes) bytes text) identities))))

(define (read-age-file port identities)
  (decrypt-age-file (get-bytevector-all port) identities))
(define (age-header-stanzas text)
  (let-values (((stanzas mac prefix rest) (header-boundary text))) stanzas))
